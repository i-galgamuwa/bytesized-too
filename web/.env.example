# ---- Server ----
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string

# ---- ByteSized backend API ----
# The Spring Boot service this dashboard reads from. The dashboard calls it
# server-side, so this host does not need to be reachable from the browser.
BACKEND_URL=http://localhost:8080
# How long to wait on a backend call before giving up (milliseconds).
BACKEND_TIMEOUT_MS=10000

# ---- Dashboard accounts ----
# There are none to configure here. Managers sign in with their backend account
# (POST /api/v1/auth/login); only MANAGER and ADMIN roles may use the dashboard.
# Create accounts with POST /api/v1/users on the backend as an ADMIN.
